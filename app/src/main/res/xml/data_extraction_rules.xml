<?xml version="1.0" encoding="utf-8"?>
<!--
    The accounts database holds secrets encrypted with an Android Keystore key.
    Keystore keys never leave the device, so a restored copy could not be decrypted.
    Users move their accounts with the password-protected .sinope export instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="sinope_db" />
        <exclude domain="database" path="sinope_db-wal" />
        <exclude domain="database" path="sinope_db-shm" />
        <exclude domain="database" path="sinope_db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="sinope_db" />
        <exclude domain="database" path="sinope_db-wal" />
        <exclude domain="database" path="sinope_db-shm" />
        <exclude domain="database" path="sinope_db-journal" />
    </device-transfer>
</data-extraction-rules>
