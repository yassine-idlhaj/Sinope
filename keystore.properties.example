# Copy to keystore.properties and fill in. That file is gitignored — never commit it.
#
# storeFile is resolved relative to the project root, so an absolute path or a path
# outside the repo is fine and preferred. Keep the keystore out of version control.
#
# Losing this keystore means you can never publish an update to the app on Google Play.
# Back it up somewhere durable and private.

storeFile=/absolute/path/to/sinope-upload.jks
storePassword=
keyAlias=upload
keyPassword=
